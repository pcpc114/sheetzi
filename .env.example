# 시트지 환경변수 — 이 파일은 "예시"입니다. 실제 값은 .env 에 넣으세요.
#
#   cp .env.example .env      (한 번만)
#   그리고 .env 를 열어 값을 채웁니다.
#
# .env 는 .gitignore 에 들어 있어 깃허브에 올라가지 않습니다. 절대 지우지 마세요.
#
# ── .env 는 언제 읽히나 ──────────────────────────────────────────────────
# 서버(`npm start`)는 시작할 때 이 폴더의 .env 를 읽습니다.
# 값을 바꾸면 서버를 껐다 켜야 반영됩니다.
# .env 가 없어도 정상입니다 — 그냥 아무 설정 없이 켜집니다.
# 읽힌 값의 "이름"은 시작 로그에 나옵니다(비밀번호·키 같은 값 자체는 찍지 않습니다).
# 그러니 켤 때 로그를 한 번 보세요. 원하는 이름이 안 보이면 적용되지 않은 것입니다.
#
# ── 같은 이름이 이미 환경변수에 있으면? ──────────────────────────────────
# 환경변수가 이깁니다. .env 는 무시됩니다(무시된 이름도 시작 로그에 나옵니다).
# 그래서 Render·Railway·Fly.io 처럼 대시보드에서 환경변수를 넣는 곳에서는
# .env 파일 없이 대시보드 값만으로 그대로 동작합니다. README 의 "배포" 참고.
#
# ── 값 적는 법 ───────────────────────────────────────────────────────────
#   SZ_PASSWORD=우리집비밀번호        따옴표 없이 그냥 씁니다
#   SZ_PASSWORD="앞뒤 공백 살리기"     따옴표를 쓰면 안쪽 그대로 들어갑니다
#   # 으로 시작하는 줄은 설명입니다
# 메모장으로 저장한다면 인코딩을 "UTF-8"(BOM 없음)로 고르세요.
#
# ── 이 파일에 있는 이름이 전부입니다 ─────────────────────────────────────
# 시트지가 읽는 환경변수는 아래 여덟 개뿐입니다. 다른 이름을 적어도 무시됩니다.
#   PORT
#   SZ_PASSWORD  SZ_PASSWORD_HASH  SZ_SESSION_SECRET  SZ_SESSION_DAYS
#   SUPABASE_URL  SUPABASE_SERVICE_KEY  SUPABASE_SCHEMA

# 서버가 사용할 포트. 비워 두거나 지우면 3000 을 씁니다.
# Render·Railway 같은 곳은 이 값을 알아서 넣어 주므로 건드리지 않아도 됩니다.
PORT=3000

# ── 접속 비밀번호 ────────────────────────────────────────────────────────
# 아래 둘 중 하나를 채우면 사이트 전체에 비밀번호가 걸립니다.
# 둘 다 비워 두면 잠금이 완전히 꺼집니다 — 주소를 아는 사람은 누구나 모든 문서를
# 읽고 쓸 수 있습니다. 인터넷에 공개할 때는 반드시 하나를 채우세요.
#
# 1) SZ_PASSWORD — 비밀번호를 그대로 적는 방법. 간편합니다.
#    다만 비밀번호 자체가 .env 파일과 호스팅 대시보드 화면에 그대로 남습니다.
SZ_PASSWORD=

# 2) SZ_PASSWORD_HASH — 공개 서버에는 이쪽을 권합니다.
#    비밀번호 대신 되돌릴 수 없는 "해시" 한 줄만 저장하므로, 이 값이 새어 나가도
#    비밀번호를 알아낼 수 없습니다. 아래 명령이 그 한 줄을 만들어 줍니다.
#
#      npm run hash-password
#
#    화면에 아무것도 안 나오는 상태에서 비밀번호를 입력하고 Enter 를 누르면
#    scrypt$16384$8$1$....$.... 형태의 한 줄이 나옵니다. 그걸 그대로 붙여넣으세요.
#
#    ⚠ 둘 다 채우면 SZ_PASSWORD_HASH 가 이깁니다(SZ_PASSWORD 는 무시됩니다).
#    ⚠ 형식이 어긋난 값을 넣으면 서버는 켜지지 않고 이유를 알려 줍니다.
#      잠금이 조용히 풀리거나 아무도 못 들어오는 것보다 낫기 때문입니다.
SZ_PASSWORD_HASH=

# 세션 서명에 쓰는 임의의 긴 문자열. 아래 명령으로 만들어 붙여넣으세요.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 이 값이 바뀌면 모든 사람이 다시 로그인해야 합니다.
# 비워 두면 켤 때마다 임시 키를 만들기 때문에, 서버를 다시 시작할 때마다
# 모두 로그아웃됩니다(시작 로그에 경고가 나옵니다). 계속 운영할 서버라면 채우세요.
SZ_SESSION_SECRET=

# 한 번 로그인하면 며칠 동안 유지되는지. 비워 두면 14일입니다(최대 365).
SZ_SESSION_DAYS=

# ── 저장소 ───────────────────────────────────────────────────────────────
# 비워 두면 data/ 폴더의 JSON 파일에 저장합니다(지금 컴퓨터에서 쓰는 방식).
# 아래 값을 채우면 Supabase 에 저장합니다.
#
# SUPABASE_URL : Supabase 프로젝트 화면 맨 위에 있는 https://....supabase.co
#   이 값이 채워져 있는지 여부 하나로 저장 방식이 정해집니다. 비우면 파일 방식입니다.
# SUPABASE_SERVICE_KEY : Supabase 의 "비밀 키". 아래 두 형식 중 아무거나 하나면 됩니다.
#   (가) 지금 방식 — Project Settings → API Keys → "Secret keys" 의 sb_secret_... 값.
#        점으로 가려져 있으니 눈 모양 아이콘으로 펼친 뒤 복사 버튼으로 복사하세요.
#        (목록이 비어 있으면 Create new secret key 로 하나 만드시면 됩니다.)
#   (나) 예전 방식 — 같은 화면의 "Legacy anon, service_role API keys" 탭에 있는
#        service_role 값. eyJ 로 시작하는 아주 긴 한 줄입니다. 지금도 그대로
#        동작하지만 Supabase 가 2026년 말에 없앨 예정이니, 새로 넣는다면 (가) 를 쓰세요.
#   어느 형식인지 알려 주는 설정은 없습니다. 서버가 값의 생김새를 보고 알아서 맞춥니다.
#   ⚠ "Publishable key"(sb_publishable_...) 와 예전 "anon" 키는 여기에 넣는 값이
#     아닙니다. 브라우저에 노출돼도 되는 공개용이라 이 표 3개에는 권한이 하나도 없고,
#     넣으면 서버가 켜지기 전에 그걸 알아보고, 어디서 올바른 키를 가져오는지 말한 뒤
#     멈춥니다. 사이트가 멀쩡히 뜬 채로 저장만 실패하는 일은 없습니다.
#   ⚠ 비밀 키는 DB 전체 권한입니다. 서버에만 두고, 브라우저·깃허브·채팅에
#     절대 노출하지 마세요. 노출됐다면 Create new secret key 로 새로 만들고 노출된
#     키는 Revoke 하세요(예전 방식 키는 Reset).
#
# ⓘ Supabase 로 바꾸면 데이터베이스는 "비어 있는 상태"로 시작합니다. data/ 폴더의
#   문서를 옮겨 주는 도구는 없습니다. 그리고 data/ 폴더는 읽지도 지우지도 않습니다 —
#   그대로 남아 있고, 이 값을 다시 비우면 예전 문서가 그대로 다시 보입니다.
#   내용을 옮기는 방법은 README 의 "Supabase 로 바꾸면 기존 문서는 어떻게 되나요" 참고.
#
# ⓘ 쓰기 전에 docs/supabase.sql 을 Supabase SQL Editor 에서 한 번 실행하세요.
#   표 세 개(sz_documents, sz_journal, sz_backups)를 만들어 줍니다.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 표를 public 이 아닌 다른 스키마에 만들었을 때만 그 이름을 적습니다.
# 비워 두면 public 입니다. 대부분 비워 두면 됩니다.
SUPABASE_SCHEMA=
